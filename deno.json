{
  "name": "@banjobyster/tallywick",
  "version": "0.1.0",
  "exports": "./core/mod.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --unstable-kv --watch adapters/deno/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write --allow-ffi --unstable-kv core/ test/ adapters/deno/",
    "check": "deno check core/ adapters/deno/ test/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.8"
  },
  "lint": {
    "rules": { "tags": ["recommended"] },
    "exclude": ["adapters/cloudflare/"]
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["adapters/cloudflare/", "**/*.md"]
  },
  "exclude": [
    "adapters/cloudflare/node_modules",
    "adapters/cloudflare/.wrangler",
    "coverage"
  ]
}
